# ========================================
# CONFIGURACIÓN PARA AWS
# ========================================
# Este es tu archivo .env para la instancia EC2
# Copia este contenido y pégalo en /ruta/proyecto/.env en AWS

# ========================================
# CONFIGURACIÓN GENERAL
# ========================================
DJANGO_SECRET_KEY=tu-secret-key-cambiar-en-produccion
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=tu-ip-aws,localhost,tu-dominio.com

# ========================================
# BASE DE DATOS (RDS)
# ========================================
USE_MYSQL=True
DB_NAME=dulceria_db
DB_USER=root
DB_PASSWORD=tu-password-db
DB_HOST=tu-rds-endpoint.rds.amazonaws.com
DB_PORT=3306

# ========================================
# INTERNACIONALIZACIÓN
# ========================================
DJANGO_LANGUAGE_CODE=es-cl
DJANGO_TIME_ZONE=America/Santiago

# ========================================
# CONFIGURACIÓN DE EMAIL - SENDGRID
# ========================================
SENDGRID_API_KEY=SG.tu-api-key-de-sendgrid-aqui
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=tu-email@gmail.com
SITE_URL=http://tu-ip-aws

# NOTA: Con SENDGRID_API_KEY configurado, el sistema automáticamente usa:
# - EMAIL_HOST_USER = 'apikey'
# - EMAIL_HOST_PASSWORD = valor de SENDGRID_API_KEY
