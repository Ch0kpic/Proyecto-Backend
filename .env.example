# ========================================
# CONFIGURACIÓN GENERAL
# ========================================
DJANGO_SECRET_KEY=tu-secret-key-aqui-cambiar-en-produccion
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=tu-ip-aws,localhost,tu-dominio.com
# ALLOWED_HOSTS se parsea como: ALLOWED_HOSTS = os.getenv("DJANGO_ALLOWED_HOSTS","").split(",")

# ========================================
# BASE DE DATOS
# ========================================
USE_MYSQL=True
DB_NAME=dulceria_db
DB_USER=root
DB_PASSWORD=tu-password-mysql
DB_HOST=localhost
DB_PORT=3306

# ========================================
# INTERNACIONALIZACIÓN
# ========================================
DJANGO_LANGUAGE_CODE=es-cl
# LANGUAGE_CODE = os.getenv("DJANGO_LANGUAGE_CODE", "es-cl")

DJANGO_TIME_ZONE=America/Santiago
# TIME_ZONE = os.getenv("DJANGO_TIME_ZONE", "America/Santiago")

# ========================================
# CONFIGURACIÓN DE EMAIL
# ========================================

# OPCIÓN 1: SendGrid (Recomendado para producción/AWS)
# ------------------------------------------------------
SENDGRID_API_KEY=SG.tu-sendgrid-api-key-aqui
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=noreply@tudominio.com
SITE_URL=https://tudominio.com

